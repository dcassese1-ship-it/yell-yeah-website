# Copy this file to .env.local and fill in your Shopify Storefront API credentials.
# Without these, the site falls back to sample placeholder products automatically.

# Your store's myshopify.com domain, e.g. yell-yeah.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Shopify Admin > Settings > Apps and sales channels > Develop apps >
# create/select an app > Configuration > enable Storefront API scopes
# (unauthenticated_read_product_listings, unauthenticated_read_product_inventory) >
# Install app > API credentials > Storefront API access token
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional, defaults to 2025-01
SHOPIFY_API_VERSION=2025-01
